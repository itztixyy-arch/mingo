#!/bin/sh
# Mingo boot animation. Started by the initramfs, continued by rcS ("continue"), and ends
# when /run/mingo.booted appears. Disable with the "nosplash" boot option.
# Preview in a running system: mingo-splash demo
T=/dev/console
exec >"$T" 2>&1

mode=$1
i=0
if [ "$mode" = demo ]; then
  rm -f /run/mingo.booted
  ( sleep 4; touch /run/mingo.booted ) &
elif [ "$mode" = continue ]; then
  read -r i < /run/mingo.splash 2>/dev/null
  case $i in ''|*[!0-9]*) i=0 ;; esac
fi

rows=0; cols=0
# the console can change size mid-boot (graphics driver loads): re-center when it does
layout() {
  set -- $(stty size < "$T" 2>/dev/null)
  [ -n "$2" ] || set -- 24 80
  [ "$1" = "$rows" ] && [ "$2" = "$cols" ] && return 1
  rows=$1; cols=$2
  top=$(( (rows - 12) / 2 )); [ $top -lt 1 ] && top=1
  col=$(( (cols - 30) / 2 )); [ $col -lt 1 ] && col=1
  return 0
}
layout

n=0
while IFS= read -r l; do eval "L$n=\$l"; n=$((n+1)); done <<'EOF'
 __  __ ___ _   _  ____  ___
|  \/  |_ _| \ | |/ ___|/ _ \
| |\/| || ||  \| | |  _| | | |
| |  | || || |\  | |_| | |_| |
|_|  |_|___|_| \_|\____|\___/
EOF

center() { # $1=row $2=text
  c=$(( (cols - ${#2}) / 2 )); [ $c -lt 1 ] && c=1
  printf '\033[%d;%dH\033[2K%s' "$1" "$c" "$2"
}

frame() { # $1=frame  $2=percent
  r=0
  while [ $r -lt 5 ]; do
    eval "l=\$L$r"
    printf '\033[%d;%dH\033[1;%dm%s' $(( top + r )) "$col" $(( 31 + ($1 / 2 + r) % 6 )) "$l"
    r=$((r + 1))
  done
  printf '\033[0;37m'
  center $(( top + 6 )) "portable linux on a stick"
  f=$(( $2 * 30 / 100 )); bar=''; k=0
  while [ $k -lt 30 ]; do
    if [ $k -lt $f ]; then bar="$bar="; else bar="$bar "; fi
    k=$((k + 1))
  done
  printf '\033[0;36m'
  center $(( top + 8 )) "[$bar] $(printf '%3d' "$2")%"
  case $(( $1 % 4 )) in 0) s='|' ;; 1) s='/' ;; 2) s='-' ;; *) s='\' ;; esac
  stage=starting
  [ -r /run/mingo.stage ] && read -r stage < /run/mingo.stage
  printf '\033[0;90m'
  center $(( top + 10 )) "$s $stage"
  echo "$1" > /run/mingo.splash 2>/dev/null
}

[ "$mode" = continue ] || printf '\033[0m\033[40m\033[2J'
printf '\033[?25l'
p=0
while :; do
  if [ -e /run/mingo.booted ] && [ $i -ge 20 ]; then break; fi
  p=$(( 95 - 95 * 20 / (i + 20) ))
  [ $((i % 3)) = 0 ] && layout && printf '\033[0m\033[40m\033[2J'
  frame $i $p
  i=$((i + 1))
  sleep 0.1 2>/dev/null || sleep 1
done
while [ $p -lt 100 ]; do
  p=$((p + 5)); [ $p -gt 100 ] && p=100
  frame $i $p; i=$((i + 1))
  sleep 0.03 2>/dev/null || true
done
printf '\033[1;32m'
center $(( top + 10 )) "Welcome to Mingo"
sleep 0.6 2>/dev/null || sleep 1
printf '\033[0m\033[2J\033[H\033[?25h'
