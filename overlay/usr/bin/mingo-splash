#!/bin/sh
# Mingo boot animation. Started by the initramfs, continued by rcS ("continue"), and ends
# when /run/mingo.booted appears. Disable with the "nosplash" boot option.
# Preview in a running system: mingo-splash demo
T=/dev/console
mode=$1
if [ "$mode" = demo ]; then
  rm -f /run/mingo.booted /run/mingo.splash
  ( sleep 4; touch /run/mingo.booted ) &
fi
# graphical boot screen when there is a framebuffer; this text version otherwise
{ date; echo "mode=$mode fb0=$(ls /dev/fb* 2>/dev/null | tr '
' ' ')"; /usr/bin/mingo-fbsplash --check; echo "check=$?"; } >> /run/splash.log 2>&1
if [ "$mode" != text ] && [ -x /usr/bin/mingo-fbsplash ] && [ -e /dev/fb0 ] && /usr/bin/mingo-fbsplash --check 2>/dev/null; then
  [ "$mode" = continue ] && exec /usr/bin/mingo-fbsplash continue
  exec /usr/bin/mingo-fbsplash
fi
exec >"$T" 2>&1

i=0
if [ "$mode" = demo ]; then
  :
elif [ "$mode" = continue ]; then
  read -r i < /run/mingo.splash 2>/dev/null
  case $i in ''|*[!0-9]*) i=0 ;; esac
fi

rows=0; cols=0
W=31   # logo width in characters
# the console can change size mid-boot (graphics driver loads): re-center when it does
layout() {
  set -- $(stty size < "$T" 2>/dev/null)
  [ -n "$2" ] || set -- 24 80
  [ "$1" = "$rows" ] && [ "$2" = "$cols" ] && return 1
  rows=$1; cols=$2
  top=$(( (rows - 11) / 2 )); [ $top -lt 1 ] && top=1
  col=$(( (cols - W) / 2 )); [ $col -lt 1 ] && col=1
  return 0
}
layout

# block letters, 5 rows; one variable per letter and row (L<letter><row>)
set_rows() { k=$1; shift; r=0; for v in "$@"; do eval "L$k$r=\$v"; r=$((r + 1)); done; }
set_rows 0 '█   █' '██ ██' '█ █ █' '█   █' '█   █'
set_rows 1 '███'   ' █ '   ' █ '   ' █ '   '███'
set_rows 2 '█   █' '██  █' '█ █ █' '█  ██' '█   █'
set_rows 3 '▄███▄' '█    ' '█  ▄▄' '█   █' '▀███▀'
set_rows 4 '▄███▄' '█   █' '█   █' '█   █' '▀███▀'
COLORS='34 34 35 35 35'   # blue -> magenta

at() { printf '\033[%d;%dH' "$1" "$2"; }
line() { # $1=row $2=text $3=visible width : centered, line cleared first
  printf '\033[%d;1H\033[2K' "$1"
  c=$(( (cols - $3) / 2 )); [ $c -lt 1 ] && c=1
  printf '\033[%d;%dH%s' "$1" "$c" "$2"
}

frame() { # $1=frame  $2=percent
  shine=$(( ($1 / 3) % 9 ))       # a white shimmer sweeps across the letters
  r=0
  while [ $r -lt 5 ]; do
    at $(( top + r )) "$col"
    k=0
    for c in $COLORS; do
      [ $k = $shine ] && c=37
      eval "printf '\033[1;%sm%s  ' $c \"\$L$k$r\""
      k=$((k + 1))
    done
    r=$((r + 1))
  done
  printf '\033[0;37m'
  line $(( top + 6 )) "portable linux on a stick" 25
  f=$(( $2 * 32 / 100 )); fill=''; rest=''; k=0
  while [ $k -lt 32 ]; do
    if [ $k -lt $f ]; then fill="$fill█"; else rest="$rest░"; fi
    k=$((k + 1))
  done
  line $(( top + 8 )) "$(printf '\033[1;36m%s\033[0;90m%s\033[0;37m  %3d%%' "$fill" "$rest" "$2")" 38
  stage=starting
  [ -r /run/mingo.stage ] && read -r stage < /run/mingo.stage
  case $(( ($1 / 3) % 4 )) in 0) d='   ' ;; 1) d='.  ' ;; 2) d='.. ' ;; *) d='...' ;; esac
  printf '\033[0;90m'
  line $(( top + 10 )) "$stage$d" $(( ${#stage} + 3 ))
  echo "$1" > /run/mingo.splash 2>/dev/null
}

[ "$mode" = continue ] || printf '\033[0m\033[40m\033[2J'
printf '\033[?25l'
p=0
while :; do
  if [ -e /run/mingo.booted ] && [ $i -ge 20 ]; then break; fi
  p=$(( 95 - 95 * 20 / (i + 20) ))
  [ $((i % 3)) = 0 ] && layout && printf '\033[0m\033[40m\033[2J'
  frame $i $p
  i=$((i + 1))
  sleep 0.1 2>/dev/null || sleep 1
done
while [ $p -lt 100 ]; do
  p=$((p + 5)); [ $p -gt 100 ] && p=100
  frame $i $p; i=$((i + 1))
  sleep 0.03 2>/dev/null || true
done
printf '\033[1;32m'
line $(( top + 10 )) "Welcome to Mingo" 16
sleep 0.6 2>/dev/null || sleep 1
printf '\033[0m\033[2J\033[H\033[?25h'
