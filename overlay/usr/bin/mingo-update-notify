#!/bin/sh
# Desktop: ask the user when a newer Mingo release exists (started by mingo-session).
new=$(mingo-update --check 2>/dev/null) || exit 0
[ "$(cat /mnt/mingo/mingo/update/ready 2>/dev/null)" = "$new" ] && exit 0
yad --title="Mingo update" --window-icon=system-software-update --image=system-software-update \
  --center --borders=16 --fixed \
  --text="<b>Mingo $new is available</b>\nYou have $(cat /etc/mingo-release).\nYour files and settings are kept." \
  --button="Later!window-close:1" --button="Download!emblem-downloads:0" || exit 0
mingo-term -e "mingo-hold mingo-update"
