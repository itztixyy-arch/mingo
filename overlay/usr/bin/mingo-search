#!/bin/sh
# Spotlight-style search (tap the Super key): apps, settings, folders, files, actions.
# Enter opens, Alt+P keeps an app in the dock, typing something that is not found searches the web.
pkill -x rofi && exit 0          # pressing Super again closes it
exec rofi -show search -modi "search:/usr/bin/mingo-search-items" \
  -theme "$HOME/.config/rofi/spotlight.rasi" -show-icons -matching fuzzy -sort -sorting-method fzf \
  -kb-custom-1 "Alt+p"
