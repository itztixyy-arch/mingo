/* Mingo menu (top-left logo): small dropdown */
* {
  font: "Inter 11";
  background-color: transparent;
  text-color: #e8edf3;
}
window {
  location: north west;
  x-offset: 8px;
  y-offset: 34px;
  width: 260px;
  background-color: #1d2129f5;
  border: 1px;
  border-color: #ffffff1f;
  border-radius: 12px;
}
mainbox { padding: 6px; children: [ listview ]; }
listview { lines: 9; fixed-height: false; dynamic: true; scrollbar: false; spacing: 1px; }
element { padding: 7px 10px; spacing: 10px; border-radius: 7px; }
element selected.normal { background-color: #3b82f6; }
element-icon { size: 18px; }
element-text { vertical-align: 0.5; }
