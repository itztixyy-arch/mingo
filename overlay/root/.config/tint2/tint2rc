# Mingo top bar: logo menu (left), status icons + clock (right)
# Backgrounds: 1 bar, 2 logo hover, 3 clock
rounded = 0
border_width = 0
border_sides = B
background_color = #0f131a 78
border_color = #ffffff 10
background_color_hover = #0f131a 78
border_color_hover = #ffffff 10
background_color_pressed = #0f131a 78
border_color_pressed = #ffffff 10

rounded = 6
border_width = 0
border_sides = TBLR
background_color = #ffffff 0
border_color = #000000 0
background_color_hover = #ffffff 16
border_color_hover = #000000 0
background_color_pressed = #ffffff 26
border_color_pressed = #000000 0

rounded = 6
border_width = 0
border_sides = TBLR
background_color = #ffffff 0
border_color = #000000 0
background_color_hover = #ffffff 14
border_color_hover = #000000 0
background_color_pressed = #ffffff 22
border_color_pressed = #000000 0

# Panel
panel_monitor = all
panel_position = top center horizontal
panel_size = 100% 30
panel_margin = 0 0
panel_padding = 8 2 10
panel_background_id = 1
panel_layer = top
strut_policy = follow_size
wm_menu = 1
panel_items = LFSBC
font_shadow = 0

# Logo menu
launcher_padding = 2 0 2
launcher_background_id = 0
launcher_icon_background_id = 2
launcher_icon_size = 20
launcher_icon_theme = Papirus-Dark
launcher_icon_theme_override = 0
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/mingo-menu.desktop
launcher_item_app = /usr/share/applications/mingo-search.desktop

# Status icons (Wi-Fi, volume)
systray_padding = 6 0 8
systray_background_id = 0
systray_icon_size = 18
systray_icon_asb = 100 0 0
systray_sort = right2left

# Battery (laptops)
battery_low_status = 15
battery_hide = 101
bat1_font = Inter Medium 10
bat2_font = Inter 8
battery_font_color = #e8edf3 100
battery_padding = 6 0
battery_background_id = 0
battery_tooltip = 1

# Clock
time1_format = %a %d %b  %H:%M
time1_font = Inter Medium 10
clock_font_color = #e8edf3 100
clock_padding = 10 0
clock_background_id = 3
clock_tooltip = %A, %d %B %Y
clock_lclick_command = mingo-term -e "mingo-hold cal -3"
