[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = (14, 44)
    width = (260, 360)
    notification_limit = 4
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 3
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    frame_color = "#ffffff22"
    separator_height = 2
    gap_size = 8
    corner_radius = 14
    font = Inter 10
    markup = full
    format = "<b>%s</b>\n%b"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 40
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1d2129f0"
    foreground = "#e8edf3"
    highlight = "#3b82f6"
    timeout = 4

[urgency_normal]
    background = "#1d2129f0"
    foreground = "#e8edf3"
    highlight = "#3b82f6"
    timeout = 6

[urgency_critical]
    background = "#3a1d22f0"
    foreground = "#ffffff"
    frame_color = "#ff5f57"
    timeout = 0
