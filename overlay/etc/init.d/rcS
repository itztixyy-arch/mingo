#!/bin/sh
# Mingo system init. The initramfs already mounted /proc /sys /dev /run and the USB drive.
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts
mountpoint -q /dev/shm || mount -t tmpfs tmpfs /dev/shm
mountpoint -q /run || mount -t tmpfs tmpfs /run
mountpoint -q /tmp || mount -t tmpfs tmpfs /tmp
hostname -F /etc/hostname

# boot animation continues from the initramfs; boot output goes to /run/boot.log
SPLASH=
if ! grep -qE 'nosplash|console=ttyS0' /proc/cmdline; then
  /usr/bin/mingo-splash continue &
  SPLASH=$!
  exec >>/run/boot.log 2>&1
fi
stage() { echo "$1" > /run/mingo.stage; }

stage "detecting hardware"
find /sys/devices -name modalias -exec cat {} + 2>/dev/null | sort -u | xargs modprobe -qa 2>/dev/null
for m in usbhid hid_generic evdev; do modprobe -q $m 2>/dev/null; done

stage "starting devices"
if command -v udevd >/dev/null 2>&1; then
  udevd --daemon
  udevadm trigger --action=add
  udevadm settle --timeout=10
else
  echo /sbin/mdev > /proc/sys/kernel/hotplug
  mdev -s
fi

# debug: serial shell when booted with console=ttyS0
if grep -q 'console=ttyS0' /proc/cmdline; then
  ( while :; do setsid /sbin/getty -n -l /usr/bin/mingo-sh 115200 ttyS0; sleep 1; done ) &
fi

stage "bringing up network"
# system message bus (NetworkManager, Wi-Fi) then NetworkManager; plain DHCP as a fallback
if command -v dbus-daemon >/dev/null 2>&1; then
  mkdir -p /run/dbus /var/lib/dbus
  dbus-uuidgen --ensure 2>/dev/null
  dbus-daemon --system --fork 2>/dev/null
fi
rfkill unblock all 2>/dev/null
if command -v NetworkManager >/dev/null 2>&1 && [ -S /run/dbus/system_bus_socket ]; then
  NetworkManager
else
  /usr/bin/mingo-net &
fi

stage "restoring your files"
/usr/bin/mingo-load

# auto-save every 3 minutes (shutdown/reboot also saves, see rcK)
if [ -f /run/mingo.dev ]; then
  ( while :; do sleep 180; /usr/bin/mingo-save >/dev/null 2>&1; done ) &
fi

# boot option "mingodebug": write what happened during boot to the stick (mingo/debug.txt)
if grep -q mingodebug /proc/cmdline && [ -f /run/mingo.dev ] && mount -o remount,rw /mnt/mingo; then
  { echo "== cmdline"; cat /proc/cmdline; echo "== fb"; cat /proc/fb; ls -l /dev/fb* /dev/dri 2>&1
    echo "== splash.log"; cat /run/splash.log; echo "== splash.err"; cat /run/splash.err
    echo "== boot.log"; cat /run/boot.log; echo "== dmesg"; dmesg | tail -150; } > /mnt/mingo/mingo/debug.txt 2>&1
  sync; mount -o remount,ro /mnt/mingo
fi
stage "ready"
touch /run/mingo.booted
[ -n "$SPLASH" ] && wait "$SPLASH"
